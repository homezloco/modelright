{
  "name": "modelright",
  "version": "0.1.0",
  "description": "Live registry of AI model specs, context windows, and per-1M-token pricing — with compare, task picks, a public JSON API, and an MCP server.",
  "license": "MIT",
  "homepage": "https://modelright.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/homezloco/modelright"
  },
  "keywords": [
    "ai-models",
    "llm",
    "model-registry",
    "pricing",
    "openrouter",
    "mcp",
    "nextjs",
    "drizzle"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx/esm scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.33.0",
    "mcp-handler": "2.1.1",
    "next": "^14.2.0",
    "postgres": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.24.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
