DATABASE_URL=postgresql://user:password@localhost:5432/modelright
INGEST_TOKEN=secret_ingest_token
CRON_SECRET=secret_cron_secret
# Salt for the daily-rotating analytics visitor hash sha256(ip|ua|date|salt).
# Any random string; rotating it resets visitor identity. Optional — dev
# default is used when unset.
ANALYTICS_SALT=change-me-random-string
ADMIN_TOKEN=secret_admin_token

## Required secrets
# MCP registry domain-auth proof record (public key material — set by LiveGraph publish)
MCP_REGISTRY_AUTH=@mcp-registry-auth
